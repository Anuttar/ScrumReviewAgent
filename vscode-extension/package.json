{
  "name": "sara-scrum-review-agent",
  "displayName": "SARA - Scrum Review Agent",
  "description": "Scrum Assistant in Reporting and Automation - Azure DevOps sprint analysis via MCP, packaged as a one-click install VS Code extension.",
  "version": "1.0.0",
  "publisher": "your-org-internal",
  "private": true,
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "sara.azuredevopsMcpProvider",
        "label": "SARA Azure DevOps MCP Server"
      }
    ],
    "commands": [
      {
        "command": "sara.configureCredentials",
        "title": "SARA: Configure Azure DevOps Credentials"
      },
      {
        "command": "sara.installAgent",
        "title": "SARA: Install Sprint Review Analyst Agent in Workspace"
      }
    ],
    "configuration": {
      "title": "SARA",
      "properties": {
        "sara.azureDevOpsOrgUrl": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Organization URL, e.g. https://dev.azure.com/your-org"
        },
        "sara.azureDevOpsProject": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Project name"
        },
        "sara.azureDevOpsTeam": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Team name"
        },
        "sara.sharepointSiteUrl": {
          "type": "string",
          "default": "",
          "description": "SharePoint site URL used for team capacity lookups (optional)"
        },
        "sara.graphTenantId": {
          "type": "string",
          "default": "",
          "description": "Microsoft Graph tenant ID used for SharePoint auth (optional)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run copy-server && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "copy-server": "node ./scripts/copy-server.js",
    "package": "npm run vscode:prepublish && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3"
  }
}
